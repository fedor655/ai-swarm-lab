# Скопируй в .env и впиши свои значения.
# .env в .gitignore и в репозиторий не попадает.

OPENAI_API_KEY=sk-ЗАМЕНИ_НА_СВОЙ_КЛЮЧ
OPENAI_BASE_URL=https://api.example.com/v1
MODEL=имя-модели
# В Byesu запускается рой из 20 агентов на модели kimi-k3.
AGENT_COUNT=20

# Секретный код для цели «побег»: генерируется make_secret.py.
# В .env попадают только соль и хеш; сам код живёт на хосте в Desktop\secret_code.txt
SWARM_SECRET_SALT=
SWARM_SECRET_HASH=
